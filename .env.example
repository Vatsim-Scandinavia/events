# These defaults suit a local install. On a public server (staging or production) set at least:
#   APP_ENV=production (or staging), APP_DEBUG=false, APP_URL=https://your-domain,
#   LOG_STACK=daily, LOG_LEVEL=warning,
#   SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true,
#   TRUSTED_PROXIES=<your proxy's address> when a reverse proxy or load balancer handles HTTPS.
# AUTH_DEV_LOGIN only ever works with APP_ENV=local.

APP_NAME="VATSIM Event Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" keeps one file per day, deleting files older than LOG_DAILY_DAYS.
LOG_STACK=single
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The reverse proxy or load balancer in front of the hub, comma separated, or * to trust the
# address requests arrive from. Needed for HTTPS to be detected when the proxy handles TLS.
# TRUSTED_PROXIES=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS. Turn on wherever the site is served over HTTPS.
# SESSION_SECURE_COOKIE=true

# VATSIM Connect sign-in. Create an OAuth client at https://auth.vatsim.net (or the sandbox,
# https://auth-dev.vatsim.net, for local development) with the redirect URL APP_URL/auth/vatsim/callback.
# VATSIM only accepts 127.0.0.1 locally (not localhost), so keep APP_URL on 127.0.0.1 and browse there too.
# The redirect and base URL default to that callback and the live server when left empty.
VATSIM_CONNECT_CLIENT_ID=
VATSIM_CONNECT_SECRET=
VATSIM_CONNECT_REDIRECT=
VATSIM_CONNECT_BASE_URL=

# Refresh ratings and subdivisions from the live VATSIM API every day. Set to false where people
# sign in with sandbox accounts (VATSIM_CONNECT_BASE_URL=https://auth-dev.vatsim.net).
VATSIM_SYNC=true

# A Discord channel webhook (Server Settings → Integrations → Webhooks). Each event is announced
# there once, when it's published. Leave empty to announce nothing.
DISCORD_EVENTS_WEBHOOK=

# Lets anyone sign in as any user from /login, without VATSIM Connect.
# Set to true on your own machine only; it only works when APP_ENV=local.
AUTH_DEV_LOGIN=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The vACC's details are normally set by admins on the settings page. Setting one
# here locks it, so it can no longer be changed in the app.
VACC_NAME=
VACC_DIVISION=
VACC_SUBDIVISION=
VACC_WEBSITE=
